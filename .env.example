# ── 쿠팡 파트너스 ─────────────────────────────
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_SUB_ID=threads-bot
DEFAULT_KEYWORD=무선 청소기

# ── 로컬 LLM (llama.cpp server / OmniRoute 등 OpenAI 호환 엔드포인트) ──
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=sk-local
LLM_MODEL=local
# Qwen3 계열 thinking 끄기 (content가 비어 나오는 문제 방지). 클라우드 API 쓰면 0
LLM_DISABLE_THINKING=1
# 계정 말투 (정보 큐레이션 톤. '직접 써봤다'는 거짓 경험담은 금지됨)
PERSONA=살림·가전 정보를 정리해서 공유하는 30대 직장인 계정. 담백하고 친근한 구어체

# ── 이미지 생성 (로컬 GPU) ────────────────────
IMAGE_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0
# 만화 컷 스타일(영어). 비우면 기본값(플랫 파스텔 일러스트, 얼굴 비노출) 사용
IMAGE_STYLE=
# 스타일 LoRA 가 있으면 경로 지정 (선택)
STYLE_LORA=
# LLM이 VRAM을 많이 쓰고 있으면 1 (느려지지만 VRAM 5~6GB 수준으로 동작)
IMAGE_CPU_OFFLOAD=0
# 한글 폰트 (비우면 맑은 고딕 자동 탐색)
FONT_PATH=

# ── 이미지 공개 URL 호스팅 (Threads는 공개 URL만 받음) ──
IMAGE_HOST=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# IMAGE_HOST=github 인 경우
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main

# ── Threads ──────────────────────────────────
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=me
