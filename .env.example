# ── 쿠팡 파트너스 ─────────────────────────────
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_SUB_ID=threads-bot

# ── 로컬 LLM (llama.cpp server / OmniRoute 등 OpenAI 호환 엔드포인트) ──
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=sk-local
LLM_MODEL=local
# Qwen3 계열 thinking 끄기 (content가 비어 나오는 문제 방지). 클라우드 API 쓰면 0
LLM_DISABLE_THINKING=1
# (선택) 계정 말투를 바꾸고 싶을 때만 지정. 비우면 기본값 사용
# PERSONA=

# ── 이미지 생성 (로컬 GPU) ────────────────────
IMAGE_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0
# (선택) 스타일 LoRA 경로
STYLE_LORA=
# LLM이 VRAM을 많이 쓰고 있으면 1 (느려지지만 VRAM 5~6GB 수준으로 동작)
IMAGE_CPU_OFFLOAD=0
# 한글 폰트 (비우면 맑은 고딕 자동 탐색)
FONT_PATH=

# ── 이미지 공개 URL 호스팅 (Threads는 공개 URL만 받음) ──
IMAGE_HOST=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# IMAGE_HOST=github 인 경우
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main

# ── (선택) 이미지 의미 검증용 비전 LLM (OpenAI 호환, 이미지 입력 지원 모델) ──
# 없으면 CLIP 순위 선별 + 기본 품질 검사만 수행
# VLM_BASE_URL=http://127.0.0.1:8081/v1
# VLM_MODEL=local
# CLIP_MODEL=openai/clip-vit-base-patch32

# ── Threads ──────────────────────────────────
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=me
